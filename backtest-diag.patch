+def gate_component_attribution(gate_df: pd.DataFrame) -> Dict[str, Any]:
+    """단계별로 '무엇 때문에 그 단계였나'를 나눈다.
+    - binding: 그 단계와 같은 값을 낸 구성 요소 비중(여럿이 동시에 낼 수 있어 합이 100%를 넘을 수 있음)
